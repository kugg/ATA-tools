<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="8"/>
    <machine_alignment value="4"/>
    <default_alignment value="4"/>
    <default_pointer_alignment value="4"/>
    <pointer_size value="4"/>
    <wchar_size value="4"/>
    <short_size value="2"/>
    <integer_size value="4"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
    <long_double_size value="8"/>
    <size_alignment_map>
      <entry size="1" alignment="1"/>
      <entry size="2" alignment="2"/>
      <entry size="4" alignment="4"/>
      <entry size="8" alignment="8"/>
    </size_alignment_map>
  </data_organization>

  <global>
    <range space="ram"/>
  </global>

  <!-- r29 is the stack pointer (ATA-tools prologue analysis). -->
  <stackpointer register="r29" space="ram" growth="negative"/>

  <!-- ATA186 MIPS-X ABI, learned from the packed main program:
         * scalar return value in r2 (v0), e.g. sub_0000012c is
           `jspci r31; ldf [r4],r2; nop` = return *(r4);
         * register arguments from r4 (a0) upward, matching the observed
           in_r4 > in_r5 > in_r6 > ... incoming-register distribution;
         * r16..r30 are callee-saved (saved/restored around calls); r23/r24
           carry the jspci call anchors and must survive calls;
         * r31 is the link register and is clobbered by every call. -->
  <default_proto>
    <prototype name="__ata186_abi" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="4" align="4"><register name="r4"/></pentry>
        <pentry minsize="1" maxsize="4" align="4"><register name="r5"/></pentry>
        <pentry minsize="1" maxsize="4" align="4"><register name="r6"/></pentry>
        <pentry minsize="1" maxsize="4" align="4"><register name="r7"/></pentry>
        <pentry minsize="1" maxsize="4" align="4"><register name="r8"/></pentry>
        <pentry minsize="1" maxsize="4" align="4"><register name="r9"/></pentry>
        <pentry minsize="1" maxsize="4" align="4"><register name="r10"/></pentry>
        <pentry minsize="1" maxsize="4" align="4"><register name="r11"/></pentry>
        <pentry minsize="1" maxsize="4" align="4"><register name="r12"/></pentry>
        <pentry minsize="1" maxsize="4" align="4"><register name="r13"/></pentry>
        <pentry minsize="1" maxsize="4" align="4"><register name="r14"/></pentry>
        <pentry minsize="1" maxsize="4" align="4"><register name="r15"/></pentry>
        <pentry minsize="1" maxsize="1024" align="4">
          <addr offset="0" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4"><register name="r2"/></pentry>
      </output>
      <unaffected>
        <register name="r0"/>
        <register name="r16"/>
        <register name="r17"/>
        <register name="r18"/>
        <register name="r19"/>
        <register name="r20"/>
        <register name="r21"/>
        <register name="r22"/>
        <register name="r23"/>
        <register name="r24"/>
        <register name="r25"/>
        <register name="r26"/>
        <register name="r27"/>
        <register name="r28"/>
        <register name="r29"/>
        <register name="r30"/>
      </unaffected>
    </prototype>
  </default_proto>

  <context_data>
    <tracked_set space="ram">
      <set name="r0" val="0" description="MIPS-X architectural zero register"/>
    </tracked_set>
  </context_data>
</compiler_spec>
