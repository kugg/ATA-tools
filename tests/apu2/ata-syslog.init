#!/bin/sh /etc/rc.common
# Project-owned: bounded UDP syslog receiver for the office SPA.
START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /opt/ata/syslog_listen.py
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
