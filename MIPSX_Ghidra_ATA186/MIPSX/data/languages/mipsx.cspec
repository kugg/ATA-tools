<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="8"/>
    <machine_alignment value="4"/>
    <default_alignment value="4"/>
    <default_pointer_alignment value="4"/>
    <pointer_size value="4"/>
    <wchar_size value="4"/>
    <short_size value="2"/>
    <integer_size value="4"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
    <long_double_size value="8"/>
    <size_alignment_map>
      <entry size="1" alignment="1"/>
      <entry size="2" alignment="2"/>
      <entry size="4" alignment="4"/>
      <entry size="8" alignment="8"/>
    </size_alignment_map>
  </data_organization>

  <global>
    <range space="ram"/>
  </global>

  <!-- ATA-tools' prologue analysis treats r29 as the firmware stack pointer. -->
  <stackpointer register="r29" space="ram" growth="negative"/>

  <!-- The ATA186 compiler ABI is not fully established.  Keep the default
       convention intentionally conservative: arguments are modeled on-stack;
       r1 is only a provisional scalar return register.  Tune this after
       observing the firmware's actual call sites. -->
  <default_proto>
    <prototype name="__ata186_unknown" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="1024" align="4">
          <addr offset="0" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4">
          <register name="r1"/>
        </pentry>
      </output>
      <unaffected>
        <register name="r0"/>
        <register name="r29"/>
      </unaffected>
    </prototype>
  </default_proto>

  <context_data>
    <tracked_set space="ram">
      <set name="r0" val="0" description="MIPS-X architectural zero register"/>
    </tracked_set>
  </context_data>
</compiler_spec>
